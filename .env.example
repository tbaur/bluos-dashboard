# BluOS Dashboard — copy to .env in the repo root
# Full reference: docs/CONFIGURATION.md (keep this file aligned when adding BSD_* vars)
# Ops / failures: docs/RUNBOOK.md
# Local UI (Vite) defaults to http://127.0.0.1:8765 — keep CORS in sync if you change it.
# Start with: make run

# Server
BSD_HOST=127.0.0.1
BSD_PORT=8000
BSD_LOG_LEVEL=INFO
BSD_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# BSD_API_TOKEN=
# BSD_TRUSTED_PROXIES=127.0.0.1
# BSD_ENABLE_OPENAPI=true
# Single-process serve from backend/: BSD_STATIC_DIR=../frontend/dist
# BSD_STATIC_DIR=../frontend/dist
# make run: BSD_FORCE_FREE_PORTS=1 to kill listeners on :8000/:8765
#
# UI token (Vite loads from frontend/.env — not this repo-root file):
#   echo 'VITE_API_TOKEN=same-as-BSD_API_TOKEN' > frontend/.env

# Discovery
BSD_DISCOVERY_METHOD=both
BSD_DISCOVERY_TIMEOUT=5
BSD_DISCOVERY_CACHE_TTL=300
BSD_EMPTY_FLEET_REDISCOVERY_SECONDS=30
BSD_DISCOVERED_GRACE_TTL=60
# BSD_SSE_KEEPALIVE_SECONDS=15
# BSD_SSE_QUEUE_SIZE=32
# BSD_ALLOW_NON_PRIVATE_IPS=false
# mDNS always browses _musc + _musp (CI zones); there is no service-name setting.
# BSD_BLUOS_PORT=11000
# BSD_WEB_UI_PORT=80

# Polling / device HTTP
BSD_POLL_INTERVAL=3
BSD_STATUS_LONG_POLL_SECONDS=100
# BSD_LONG_POLL_READ_SLACK_SECONDS=5
# BSD_LONG_POLL_GAP_SECONDS=1
BSD_DEVICE_HTTP_TIMEOUT=3
BSD_MAX_CONCURRENT_DEVICE_CALLS=20
BSD_CONTROL_RATE_LIMIT_SECONDS=0.1
BSD_API_RATE_LIMIT_SECONDS=0.05
# BSD_FLEET_UPGRADES_CACHE_SECONDS=30
BSD_CIRCUIT_FAILURE_THRESHOLD=5
BSD_CIRCUIT_SLOW_POLL_SECONDS=15

# XML hardening
# BSD_MAX_XML_SIZE=1048576
# BSD_MAX_XML_DEPTH=20
# BSD_MAX_XML_ELEMENTS=10000
